{
    "name": "nocline/laravel",
    "description": "Nocline client for Laravel: ping your Nocline hub from the scheduler and from jobs (heartbeat / dead man's switch monitoring).",
    "type": "library",
    "keywords": ["laravel", "nocline", "heartbeat", "cron", "monitoring", "scheduler"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Nocline\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nocline\\Laravel\\NoclineServiceProvider"
            ],
            "aliases": {
                "Nocline": "Nocline\\Laravel\\Facades\\Nocline"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}