APP_NAME=Phare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Phare (voir docs/deploy/hub.md) ---
# PHARE_PUBLIC_URL=${APP_URL}

# Coffre (phase 2) — clé 32 octets base64, distincte de APP_KEY
# Générer : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;" — à sauvegarder à part (perte = secrets irrécupérables)
VAULT_MASTER_KEY=

# Updates: GitHub repository checked daily for a newer release (set PHARE_UPDATE_CHECK=false to disable)
PHARE_REPOSITORY=mchev/phare
PHARE_UPDATE_CHECK=true

# Agent install (servers download from the official GitHub release matching VERSION — no Go on the hub)
PHARE_OFFICIAL_REPOSITORY=mchev/phare
# PHARE_AGENT_DOWNLOAD_URL=https://example.com/phare-agent-linux-{arch}

# Activity log (audit_logs) retention in days (phare:audit:prune runs daily)
PHARE_AUDIT_RETENTION_DAYS=365
